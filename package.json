{
  "name": "ollama-chat-desktop",
  "version": "0.1.0",
  "description": "A polished local AI chat desktop app powered by Ollama.",
  "main": "src/main.cjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ollamachat.desktop",
    "productName": "Orbit Chat",
    "asar": true,
    "files": ["src/**/*", "assets/**/*", "scripts/**/*", "README.md"],
    "directories": { "output": "release" },
    "generateUpdatesFilesForAllChannels": false,
    "publish": [],
    "linux": { "target": ["AppImage"], "category": "Utility" },
    "win": { "target": "nsis", "signAndEditExecutable": false },
    "mac": { "target": "dmg", "category": "public.app-category.productivity" }
  }
}
